# 日常站点配置在部署后的后台管理：/admin/settings/、/admin/appearance/、/admin/users/。
# 首次启动会持久化站点设置；以后后台保存值优先，重启/重跑部署不覆盖。
# 一键部署会自动创建环境文件，无需先复制本文件。
# Docker 使用项目根目录 .env；原生 systemd 使用 /etc/newpress/newpress.env。
# 原生应用本身不会自动读取项目 .env，由 systemd 注入环境变量。

# 必填部署边界：填写用户实际访问的 origin。TLS 由外部 NGINX/Caddy 配置。
NEWPRESS_PUBLIC_URL=http://localhost:8080
NEWPRESS_HTTP_PORT=8080
NEWPRESS_HTTP_BIND=0.0.0.0

# PostgreSQL 插件 HTTPS Webhook：默认关闭，插件还需显式授权 http.send。
# 所有共享实例应统一配置；关闭不召回已领取的请求，结果仍保留供核对。
NEWPRESS_PLUGIN_WEBHOOKS_ENABLED=false

# 反向代理设置请手动编辑此文件，命令行向导不询问；local 本机，remote 远程/容器，none HTTP 直连。
# 使用本机反代时将上方 NEWPRESS_HTTP_BIND 改为 127.0.0.1；证书与外部 NGINX/Caddy 由你配置。
# NEWPRESS_PROXY_MODE=local
# NEWPRESS_EXTERNAL_PROXY_CIDRS=10.0.0.5/32
# NEWPRESS_SOURCE_MODE=auto
# 自定义公开镜像源用 HTTPS 前缀，多个用逗号分隔；official 策略忽略镜像源。
# NEWPRESS_DOCKER_MIRRORS=https://mirror.example.com/docker.io
# NEWPRESS_GCR_MIRRORS=https://mirror.example.com/gcr.io
# NEWPRESS_GOPROXY 由脚本测速后生成；NGINX 内部代理可按文件设置生成，也可指定独立手动配置。
# NEWPRESS_NGINX_CONFIG=./deploy/nginx.manual.conf
# 已设置的镜像引用优先，必须包含 @sha256:<64位十六进制>，重跑不会改回仓库默认版本。
# 脚本生成的 *_IMAGE_ORIGIN / *_IMAGE_SELECTED 用于记录选源前后的引用，不需手动修改。
# 运维更换版本直接修改对应 *_IMAGE；删除该项及其两项记录可恢复仓库默认镜像。
# NEWPRESS_GO_IMAGE=golang:<版本>@sha256:<digest>
# NEWPRESS_RUNTIME_IMAGE=gcr.io/distroless/static-debian13:nonroot@sha256:<digest>
# NEWPRESS_POSTGRES_IMAGE=postgres:<版本>@sha256:<digest>
# NEWPRESS_PROXY_IMAGE=nginxinc/nginx-unprivileged:<版本>@sha256:<digest>
# 手动 Compose 的国内 Go 下载配置（显式启用；| 在超时/5xx 时也回退）：
# NEWPRESS_GOPROXY=https://goproxy.cn|https://goproxy.io|https://proxy.golang.org
# 保留官方校验数据库身份；Go 会经支持 sumdb 的模块代理获取校验记录。
# NEWPRESS_GOSUMDB=sum.golang.org
# 不要使用 GOSUMDB=off 或关闭 TLS 来解决下载失败；安装向导支持自动探测和切换可用镜像。

# Docker 镜像和构建信息（原生模式忽略）。
NEWPRESS_IMAGE=newpress:local
NEWPRESS_VERSION=1.0.0-beta.1
NEWPRESS_COMMIT=local
NEWPRESS_BUILD_DATE=unknown
NEWPRESS_SECRETS_DIR=./.secrets

# 附加 Compose 配置：脚本从已有容器记录恢复，或通过 --compose-file 按顺序显式选择。
# 部署后保存为下列标准变量，后续脚本和普通 docker compose 命令都会复用。
# 示例包含邮件和在线更新 secret；请先准备对应 secret 文件。
# COMPOSE_PATH_SEPARATOR=;
# COMPOSE_FILE="compose.yaml;deploy/compose.mail.yaml;deploy/compose.updates-secret.yaml"

# 通常保持注释，由部署脚本寻找未占用子网；手动 Compose 默认 172.30.0.0/24。
# 如自定义，三项需配套设置。原生服务位于反向代理后时也需设置精确可信来源。
# NEWPRESS_EDGE_SUBNET=172.30.0.0/24
# NEWPRESS_PROXY_IPV4=172.30.0.2
# NEWPRESS_TRUSTED_PROXY_CIDRS=172.30.0.2/32

# CDN 回源网段与本地代理分开填写；使用控制台/官方接口的当前列表。
# 网段不能与本地代理重叠，也不能填写全网；ESA 需启用 Ali-Real-Client-IP。
# NEWPRESS_CDN_CLOUDFLARE_CIDRS=
# NEWPRESS_CDN_ESA_CIDRS=
# NEWPRESS_CDN_EDGEONE_CIDRS=
# 可选：由 CDN 覆盖 X-NewPress-Origin-Token，额外验证本站回源（32–512 字节随机值）。
# NEWPRESS_CDN_CLOUDFLARE_ORIGIN_TOKEN=
# NEWPRESS_CDN_ESA_ORIGIN_TOKEN=
# NEWPRESS_CDN_EDGEONE_ORIGIN_TOKEN=
# 原生部署可用以上变量的 _FILE 版本；同名直接变量（包括空值）优先于文件。

# 首次引导项：仅空站点/空用户库使用。已有设置和账号在后台修改。
# 自定义 PostgreSQL 部署可改用一次性管理员认领：在应用环境设置 NEWPRESS_SETUP_TOKEN_FILE，
# 指向由你的编排系统挂载的至少 32 字节随机密钥文件；必须移除 NEWPRESS_ADMIN_PASSWORD_HASH(_FILE)。
# 默认 Docker Compose 会注入管理员 hash，且不传递 setup token，仍用上面的首次登录凭据流程。
# NEWPRESS_SETUP_TOKEN=
# NEWPRESS_SETUP_TOKEN_FILE=/run/secrets/newpress_setup_token  # 自定义编排挂载；标准 Compose 不创建此 secret
# NEWPRESS_SITE_TITLE=NewPress
# NEWPRESS_SITE_TAGLINE=文章、资源与社区
# NEWPRESS_ADMIN_USERNAME=admin
# 首次交互安装支持隐藏输入密码并显示位数；忘记登录名/密码请使用 bash scripts/deploy.sh admin。
# 不要在本文件保存明文密码；自设密码不会写入 first-login.txt。
# NEWPRESS_ADMIN_EMAIL=admin@localhost.invalid
# NEWPRESS_ADMIN_DISPLAY_NAME=站点管理员
# NEWPRESS_ADMIN_LOCALE=zh-CN
NEWPRESS_SEED_DEMO=false

# 运营统计：公开页面请求的有界日聚合；关闭后仍可查看保留数据。
NEWPRESS_ANALYTICS_ENABLED=true

# 受信内置社区扩展：启用后 /community/ 显示独立圈子，默认关闭。
NEWPRESS_COMMUNITY_ENABLED=false

# 前台「在线工具 → 四端网站截图」的本机 Playwright 渲染服务。
# 与应用处于同一网络命名空间；安装 Playwright Chromium 后运行 npm run tool:mockup。
# NEWPRESS_DEVICE_MOCKUP_URL=http://127.0.0.1:4173

# 官方插件/主题目录：内置 catalog.extensions-v2.json 双源及公钥，后台不能添加任意第三方源。
# 内置源仅使用当前签名目录，失败时报告错误；安装后仍需显式启用插件或选择主题。
# 目录使用公开 GitHub raw / Gitee raw URL，两个镜像用逗号分隔。服务器并行测速、校验后自动选源，下载失败自动切换同版本镜像。
# Gitee 用于无法稳定访问 GitHub 的国内服务器；两个仓库发布相同签名目录与插件包，开发与发布约定见 plugins/README.md。
# 以下两项均留空时使用内置官方源；覆盖时必须同时填写。评论来源仍支持离线手动安装。
# NEWPRESS_OFFICIAL_PLUGIN_CATALOGS=
# NEWPRESS_OFFICIAL_PLUGIN_PUBLIC_KEY=
# Optional themes come from Orangefen/NewPress_Theme and its Gitee mirror.
# New installations preinstall only Chunnel; catalog entries are installed on demand.
# Optional override: set both values together. The theme key is separate from
# the plugin key. Never put a private key here; omit both to use built-in defaults.
# Docker 和原生均传递主题覆盖；使用内置源时删除或注释两项，不要设置为空字符串。
# NEWPRESS_OFFICIAL_THEME_CATALOGS=
# NEWPRESS_OFFICIAL_THEME_PUBLIC_KEY=

# 资源和认证边界：修改后需重新部署/重启；不会被站点设置导出覆盖。
NEWPRESS_ADMIN_SESSION_TTL=12h
NEWPRESS_ADMIN_IDLE_TTL=30m
NEWPRESS_MAX_UPLOAD_BYTES=67108864
# PostgreSQL 每个 NewPress 进程的连接上限；多副本时按数据库连接预算分配。
NEWPRESS_DB_MAX_CONNS=16
# 启动前实际打开并检查的最小连接数，范围 1..NEWPRESS_DB_MAX_CONNS。
# 提高可减少首次并发建连等待，也会持续占用更多数据库连接。
NEWPRESS_DB_MIN_CONNS=1

# 注册确认和密码恢复邮件。注册方式在后台站点设置中选择，默认关闭。
# 公网站点必须使用 HTTPS；SMTP 默认强制 STARTTLS。密码建议放在权限受限的 secret 文件。
# NEWPRESS_SMTP_ADDR=smtp.example.com:587
# NEWPRESS_SMTP_MODE=starttls
# NEWPRESS_SMTP_FROM=noreply@example.com
# NEWPRESS_SMTP_USERNAME=noreply@example.com
# NEWPRESS_SMTP_PASSWORD_FILE=/run/secrets/smtp_password

# 注册字段与快捷登录在后台「站点设置 → 注册与账号」配置，外部供应商需另行开通并完成实际登录测试。
# 推荐在后台「站点设置 → 登录与短信」填写全部凭据，保存即生效。

# 核心更新在 /admin/updates/ 确认安装；默认 GitHub chunyangnet/NewPress 与 Gitee chunyangnet_0/newpress
# 的 releases 分支 updates/beta.json 公开双源，无需访问令牌。
# 官方公钥已内置，默认留空即可。私有源或自定义发布者通过受信渠道取得公钥，
# 将其 Ed25519 .pub 文件中的 Base64 文本填入下项；非空值覆盖内置官方公钥。
# NEWPRESS_UPDATE_PUBLIC_KEY=
# 以下是部署默认值。可在后台“系统更新 → 更新策略”覆盖或恢复，检查间隔填 0 关闭自动检查。
# NEWPRESS_UPDATE_CHECK_INTERVAL=6h
# NEWPRESS_UPDATE_OBSERVE_FOR=2m
# PostgreSQL 部署由运维提供只读恢复回执，字段与配置见 README.md「后台核心更新」。
# NEWPRESS_UPDATE_BACKUP_RECEIPT_FILE=/etc/newpress/update-recovery/backup.json
# Docker 使用独立 newpress_updates 卷；公开源回执挂载见 deploy/compose.update-recovery.yaml。
# 私有源可另用 deploy/compose.updates-secret.yaml 配置令牌和回执。
# 原生脚本自动设置 NEWPRESS_UPDATE_DIR=/var/lib/newpress/updates。
# 不要把数据库密码、管理员明文密码或 Gitee token 写进此文件。
